# PostgreSQL connection (required for Prisma)
DATABASE_URL="postgresql://USER@localhost:5432/postgres?schema=public"

# OpenAI (required for AI features)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Local VPN HTTP proxy for Node (macOS system proxy is NOT used by Node automatically)
# OPENAI_HTTPS_PROXY="http://127.0.0.1:8118"
# Optional OpenAI-compatible relay
# OPENAI_BASE_URL="https://your-proxy.example/v1"

# Doubao / Ark API (optional legacy)
ARK_API_KEY=""
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
ARK_MODEL=""
ARK_ONBOARDING_MODEL=""
